---
import '@fontsource-variable/geist';
import '@fontsource-variable/geist-mono';
import '../styles/base.css';
import Nav from '../components/Nav.astro';
import Cursor from '../components/Cursor.astro';
import DotField from '../components/DotField.astro';
import CommandMenu from '../components/CommandMenu.astro';
import Lightbox from '../components/Lightbox.astro';
import { profile } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  home?: boolean;
  ogImage?: string;
}

const {
  title = `${profile.name} | Junior Network Engineer, CCNA`,
  description = profile.description,
  home = false,
  ogImage = '/og.png',
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogUrl = new URL(ogImage, Astro.site).href;

const personLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: profile.name,
  jobTitle: profile.role,
  url: profile.site,
  email: `mailto:${profile.email}`,
  address: { '@type': 'PostalAddress', addressLocality: 'Goes', addressRegion: 'Zeeland', addressCountry: 'NL' },
  sameAs: [profile.github, profile.linkedin],
  knowsAbout: ['Cisco IOS', 'OSPF', 'VLAN', 'HSRP', 'Layer 2 security', 'Network operations'],
  hasCredential: [
    { '@type': 'EducationalOccupationalCredential', name: 'Cisco Certified Network Associate (CCNA 200-301)', credentialCategory: 'certification' },
    { '@type': 'EducationalOccupationalCredential', name: 'Microsoft Applied Skills: Administer Active Directory Domain Services', credentialCategory: 'certification' },
    { '@type': 'EducationalOccupationalCredential', name: 'Microsoft Applied Skills: Get started with identities and access using Microsoft Entra', credentialCategory: 'certification' },
  ],
};
---

<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#f3f3f4" />
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={profile.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogUrl} />

    <script type="application/ld+json" set:html={JSON.stringify(personLd)} />

    <!-- Theme before first paint: stored choice, else the OS preference. -->
    <script is:inline>
      (function () {
        var t;
        try { t = localStorage.getItem('theme'); } catch (e) {}
        if (t !== 'light' && t !== 'dark') t = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        var r = document.documentElement;
        r.dataset.theme = t;
        r.classList.add('js');
        var m = document.querySelector('meta[name="theme-color"]');
        if (m) m.content = t === 'dark' ? '#0b0b0c' : '#f3f3f4';
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <DotField />
    <Nav home={home} />
    <main id="main">
      <slot />
    </main>
    <slot name="after" />
    <CommandMenu />
    <Lightbox />
    <Cursor />

    <script>
      import { startMotion } from '../scripts/core';
      startMotion();

      // Copy buttons on CLI blocks (lab pages).
      document.addEventListener('click', async (e) => {
        const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('.codeblock-copy');
        if (!btn) return;
        const code = btn.parentElement?.querySelector('code')?.textContent ?? '';
        try {
          await navigator.clipboard.writeText(code);
          btn.textContent = 'Copied';
          btn.dataset.state = 'done';
          setTimeout(() => {
            btn.textContent = 'Copy';
            delete btn.dataset.state;
          }, 1600);
        } catch {
          btn.textContent = 'Press Ctrl+C';
        }
      });
    </script>
  </body>
</html>
