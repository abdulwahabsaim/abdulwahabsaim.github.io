---
import { Image, getImage } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import { credentials, training } from '../data/site';

const items = await Promise.all(
  credentials.map(async (c) => ({
    ...c,
    full: (await getImage({ src: c.image, width: 1800, format: 'webp', quality: 82 })).src,
  })),
);
---

<section class="section creds" id="credentials" aria-labelledby="creds-title">
  <div class="container">
    <header class="section-head">
      <h2 class="h2" id="creds-title" data-reveal>Credentials</h2>
      <p class="lead" data-reveal style="--d:80">
        A Cisco certification, two Microsoft Applied Skills and an Atlassian credential. Tap any certificate to read it.
      </p>
    </header>

    <div class="bento" data-rail data-reveal>
      {
        items.map((c, i) => (
          <article class={`cred cred--${c.id}`}>
            <button
              class="cred__media"
              style={`--ratio:${(c.image.width / c.image.height).toFixed(4)}`}
              type="button"
              data-lightbox={c.full}
              data-caption={`${c.title} (${c.issuer})`}
              data-group="certs"
              data-cursor="view"
              data-cursor-label="View"
              aria-label={`View the ${c.title} certificate`}
            >
              <Image
                src={c.image}
                alt=""
                widths={[480, 760, 1100]}
                sizes={c.id === 'ccna' || c.id === 'jsm' ? '(max-width: 900px) 92vw, 680px' : '(max-width: 900px) 92vw, 480px'}
                loading="lazy"
              />
            </button>
            <div class="cred__body">
              <p class="cred__issuer">
                <Icon name={c.icon} />
                <span>{c.issuer}</span>
                <span class="cred__kind mono">{c.kind}</span>
              </p>
              <h3 class="cred__title">{c.title}</h3>
              <p class="cred__meta">
                <span class="mono">{c.code}</span>
                <span class="cred__date">{c.date}</span>
              </p>
              <p class="cred__note">{c.note}</p>
              {c.verify && (
                <a class="btn btn--ghost btn--sm cred__verify" href={c.verify.href} target="_blank" rel="noopener">
                  <Icon name="ph:seal-check" />
                  <span>{c.verify.label}</span>
                  <Icon name="ph:arrow-up-right" class="i-arrow" />
                </a>
              )}
            </div>
          </article>
        ))
      }
    </div>

    <ul class="training" data-reveal>
      {
        training.map((t) => (
          <li>
            <span class="training__status mono">{t.status}</span>
            <span class="training__label">{t.label}</span>
            <span class="training__where">{t.where}</span>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .bento {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: clamp(14px, 1.6vw, 20px);
  }

  .cred {
    display: grid;
    grid-template-rows: auto 1fr;
    border-radius: var(--r-panel);
    background: var(--surface);
    box-shadow: 0 0 0 1px var(--line-2);
    overflow: hidden;
  }

  .cred--ccna {
    grid-column: span 7;
  }

  .cred--ms-adds {
    grid-column: span 5;
  }

  .cred--ms-entra {
    grid-column: span 5;
  }

  .cred--jsm {
    grid-column: span 7;
  }

  .cred__media {
    display: grid;
    place-items: center;
    padding: clamp(20px, 3.4vw, 44px);
    background:
      radial-gradient(120% 90% at 50% 0%, rgb(var(--accent-rgb) / 0.1), transparent 60%),
      var(--surface-2);
    overflow: hidden;
  }

  /* Definite width from the known ratio: the box is reserved before load (no layout shift)
     and still hugs the certificate so the shadow sits on the paper, not on empty space. */
  .cred__media img {
    width: min(100%, calc(300px * var(--ratio)));
    height: auto;
    border-radius: 6px;
    box-shadow:
      0 0 0 1px rgb(0 0 0 / 0.06),
      0 24px 40px -22px rgb(var(--shadow-tint) / 0.55);
    transform: rotate(-1.6deg);
    transition: transform 0.7s var(--ease-out);
  }

  .cred:nth-child(even) .cred__media img {
    transform: rotate(1.4deg);
  }

  @media (hover: hover) {
    .cred__media:hover img {
      transform: rotate(0deg) scale(1.03);
    }
  }

  .cred__body {
    display: grid;
    gap: 10px;
    align-content: start;
    padding: clamp(20px, 2.6vw, 30px);
  }

  .cred__issuer {
    display: flex;
    align-items: center;
    gap: 8px;
    font-weight: 500;
    font-size: 0.92rem;
  }

  .cred__issuer svg {
    width: 20px;
    height: 20px;
  }

  .cred__kind {
    margin-left: auto;
    font-size: 0.72rem;
    color: var(--text-3);
  }

  .cred__title {
    font-size: clamp(1.15rem, 1.7vw, 1.45rem);
    line-height: 1.2;
    letter-spacing: -0.025em;
  }

  .cred__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 14px;
    font-size: 0.85rem;
    color: var(--text-2);
  }

  .cred__note {
    font-size: 0.9rem;
    color: var(--text-3);
  }

  .cred__verify {
    justify-self: start;
    margin-top: 8px;
    gap: 8px;
  }

  .cred__verify svg:first-child {
    color: var(--accent-text);
  }

  .training {
    list-style: none;
    padding: 0;
    margin-top: clamp(20px, 3vw, 28px);
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(14px, 1.6vw, 20px);
  }

  .training li {
    display: grid;
    gap: 6px;
    padding: 20px 24px;
    border-radius: var(--r-card);
    box-shadow: inset 0 0 0 1px var(--line-2);
  }

  .training__status {
    font-size: 0.72rem;
    color: var(--accent-text);
  }

  .training__label {
    font-weight: 500;
  }

  .training__where {
    font-size: 0.88rem;
    color: var(--text-3);
  }

  @media (max-width: 700px) {
    .bento {
      --rail-w: 86%;
      align-items: stretch;
    }
    .cred__media {
      padding: 18px;
    }
    .cred__media img {
      width: min(100%, calc(190px * var(--ratio)));
    }
  }

  @media (max-width: 900px) {
    .cred--ccna,
    .cred--ms-adds,
    .cred--ms-entra,
    .cred--jsm {
      grid-column: span 12;
    }
    .training {
      grid-template-columns: 1fr;
    }
  }

  @media (min-width: 560px) and (max-width: 900px) {
    .cred--ms-adds,
    .cred--ms-entra {
      grid-column: span 6;
    }
  }
</style>
