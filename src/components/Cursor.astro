---
/* Dot + trailing ring cursor (parthh.in style). Fine pointers only, never with reduced motion. */
---

<div class="cursor" aria-hidden="true" data-cursor-root>
  <div class="cursor__ring"><span class="cursor__label"></span></div>
  <div class="cursor__dot"></div>
</div>

<style>
  .cursor {
    position: fixed;
    inset: 0;
    z-index: var(--z-cursor);
    pointer-events: none;
    display: none;
  }

  :global(html.has-cursor) .cursor {
    display: block;
  }

  .cursor__dot,
  .cursor__ring {
    position: absolute;
    top: 0;
    left: 0;
    border-radius: 50%;
    will-change: translate, scale;
  }

  .cursor__dot {
    width: 6px;
    height: 6px;
    margin: -3px 0 0 -3px;
    background: var(--accent);
    transition:
      opacity 0.2s ease,
      scale 0.3s var(--ease-out);
  }

  .cursor__ring {
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    margin: -19px 0 0 -19px;
    box-shadow: inset 0 0 0 1px rgb(var(--text-rgb) / 0.35);
    transition:
      width 0.45s var(--ease-out),
      height 0.45s var(--ease-out),
      margin 0.45s var(--ease-out),
      background-color 0.35s ease,
      box-shadow 0.35s ease,
      opacity 0.3s ease,
      scale 0.3s var(--ease-out);
  }

  .cursor__label {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--accent-ink);
    opacity: 0;
    transition: opacity 0.2s ease;
  }

  .cursor.is-link .cursor__ring {
    width: 56px;
    height: 56px;
    margin: -28px 0 0 -28px;
    background: rgb(var(--text-rgb) / 0.06);
    box-shadow: inset 0 0 0 1px rgb(var(--text-rgb) / 0.5);
  }

  .cursor.is-view .cursor__ring {
    width: 86px;
    height: 86px;
    margin: -43px 0 0 -43px;
    background: var(--accent);
    box-shadow: none;
  }

  .cursor.is-view .cursor__label {
    opacity: 1;
  }

  .cursor.is-view .cursor__dot {
    scale: 0;
  }

  .cursor.is-text .cursor__ring {
    opacity: 0;
  }

  .cursor.is-hidden .cursor__ring,
  .cursor.is-hidden .cursor__dot {
    opacity: 0;
  }

  .cursor.is-down .cursor__ring {
    scale: 0.85;
  }
</style>

<script>
  import { prefersReduced, finePointer } from '../scripts/core';
  import { motion } from '../config/motion';

  const root = document.querySelector<HTMLElement>('[data-cursor-root]')!;
  const ring = root.querySelector<HTMLElement>('.cursor__ring')!;
  const dot = root.querySelector<HTMLElement>('.cursor__dot')!;
  const label = root.querySelector<HTMLElement>('.cursor__label')!;

  if (finePointer() && !prefersReduced()) {
    document.documentElement.classList.add('has-cursor');
    root.classList.add('is-hidden');
    let mx = -100,
      my = -100,
      rx = -100,
      ry = -100,
      raf = 0,
      seen = false;

    const loop = () => {
      rx += (mx - rx) * motion.cursor.ringEase;
      ry += (my - ry) * motion.cursor.ringEase;
      // Position with the translate property, not transform: CSS applies `scale` after `transform`,
      // so a transform-based position would be scaled toward the page corner on click.
      ring.style.translate = `${rx}px ${ry}px`;
      if (Math.abs(mx - rx) > 0.1 || Math.abs(my - ry) > 0.1) raf = requestAnimationFrame(loop);
      else raf = 0;
    };

    window.addEventListener(
      'pointermove',
      (e) => {
        if (e.pointerType !== 'mouse') return;
        mx = e.clientX;
        my = e.clientY;
        if (!seen) {
          rx = mx;
          ry = my;
          seen = true;
        }
        dot.style.translate = `${mx}px ${my}px`;
        root.classList.remove('is-hidden');
        if (!raf) raf = requestAnimationFrame(loop);
      },
      { passive: true },
    );

    document.addEventListener('pointerover', (e) => {
      const t = e.target as HTMLElement;
      const view = t.closest<HTMLElement>('[data-cursor="view"]');
      const text = t.closest('input, textarea, [contenteditable]');
      const link = t.closest('a, button, [role="button"], summary, label, [data-cursor="link"]');
      root.classList.toggle('is-view', !!view);
      root.classList.toggle('is-text', !!text);
      root.classList.toggle('is-link', !view && !text && !!link);
      label.textContent = view?.dataset.cursorLabel || 'Open';
    });

    // Modal <dialog>s render in the browser's top layer, above any z-index. Move the cursor into
    // the open dialog so it stays visible there, and back to <body> when the dialog closes.
    const follow = () => {
      const open = [...document.querySelectorAll<HTMLDialogElement>('dialog[open]')].pop();
      const host = open ?? document.body;
      if (root.parentElement !== host) host.appendChild(root);
    };
    new MutationObserver(follow).observe(document.body, { attributes: true, attributeFilter: ['open'], subtree: true });

    document.documentElement.addEventListener('pointerleave', () => root.classList.add('is-hidden'));
    window.addEventListener('pointerdown', () => root.classList.add('is-down'));
    window.addEventListener('pointerup', () => root.classList.remove('is-down'));
  }
</script>
