---
/*
 * Shafisma-style project rows: the row fills on hover, a topology preview trails the cursor,
 * and a soft tick plays. Used on the home page (inside folders) and on /labs/.
 */
import type { CollectionEntry } from 'astro:content';
import { getImage } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import { topologies } from '../data/topologies';

interface Props {
  labs: CollectionEntry<'labs'>[];
  id?: string;
  /** Show only the first N rows until "Show all" is pressed. */
  limit?: number;
}
const { labs, id, limit } = Astro.props;
const capped = !!limit && labs.length > limit;

const rows = await Promise.all(
  labs.map(async (l) => ({
    lab: l,
    // Prefer the redrawn topology; fall back to the Packet Tracer screenshot.
    preview: topologies[l.id]
      ? `/topology/${l.id}.svg`
      : l.data.image
        ? (await getImage({ src: l.data.image, width: 560, format: 'webp', quality: 74 })).src
        : '',
  })),
);
---

<ol class:list={['rows', { 'is-capped': capped }]} id={id} data-rows>
  {
    rows.map(({ lab, preview }, i) => (
      <li style={`--r:${i}`} data-extra={capped && i >= limit! ? '' : undefined}>
        <a class="row" href={`/labs/${lab.id}/`} data-preview={preview} data-cursor="link">
          <span class="row__no mono">{String(lab.data.order).padStart(2, '0')}</span>
          <span class="row__name">{lab.data.name}</span>
          <span class="row__tags">{lab.data.tags.slice(0, 3).join(', ')}</span>
          <span class="row__plat mono">{lab.data.status === 'in-progress' ? 'In progress' : lab.data.platform}</span>
          <Icon name="ph:arrow-up-right" class="row__go" />
        </a>
      </li>
    ))
  }
</ol>
{
  capped && (
    <button class="btn btn--ghost btn--sm rows-more" type="button" aria-expanded="false" data-rows-more>
      <span data-label-more>Show all {labs.length} labs</span>
      <span data-label-less hidden>Show fewer</span>
      <Icon name="ph:caret-down" class="rows-more__icon" />
    </button>
  )
}

<style>
  .rows.is-capped li[data-extra] {
    display: none;
  }

  .rows-more {
    margin-top: 20px;
  }

  .rows-more__icon {
    transition: transform 0.4s var(--ease-out);
  }

  .rows-more[aria-expanded='true'] .rows-more__icon {
    transform: rotate(180deg);
  }

  .rows {
    list-style: none;
    padding: 0;
    margin: 0;
    border-top: 1px solid var(--line-2);
  }

  .rows li {
    border-bottom: 1px solid var(--line);
  }

  .row {
    position: relative;
    display: grid;
    grid-template-columns: 56px minmax(0, 1.5fr) minmax(0, 1.2fr) 120px 22px;
    align-items: center;
    gap: 20px;
    padding: 22px 20px;
    isolation: isolate;
    color: var(--text);
    transition: color 0.35s var(--ease-out);
  }

  .row::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--text);
    transform: scaleY(0);
    transform-origin: 50% 100%;
    transition: transform 0.45s var(--ease-out);
  }

  .row__no {
    font-size: 0.8rem;
    color: var(--text-3);
    transition: color 0.35s ease;
  }

  .row__name {
    font-size: clamp(1.05rem, 1.6vw, 1.35rem);
    font-weight: 500;
    letter-spacing: -0.02em;
    line-height: 1.25;
  }

  .row__tags {
    font-size: 0.9rem;
    color: var(--text-2);
    transition: color 0.35s ease;
  }

  .row__plat {
    font-size: 0.75rem;
    color: var(--text-3);
    text-align: right;
    transition: color 0.35s ease;
  }

  .row__go {
    width: 20px;
    height: 20px;
    color: var(--text-3);
    transition:
      transform 0.45s var(--ease-out),
      color 0.35s ease;
  }

  @media (hover: hover) {
    .row:hover,
    .row:focus-visible {
      color: var(--bg);
    }
    .row:hover::before,
    .row:focus-visible::before {
      transform: scaleY(1);
      transform-origin: 50% 0;
    }
    .row:hover :is(.row__no, .row__tags, .row__plat),
    .row:focus-visible :is(.row__no, .row__tags, .row__plat) {
      color: rgb(var(--bg-rgb) / 0.7);
    }
    .row:hover .row__go,
    .row:focus-visible .row__go {
      color: var(--accent);
      transform: translate(3px, -3px) rotate(45deg);
    }
  }

  .row:focus-visible {
    outline-offset: -2px;
  }

  @media (max-width: 900px) {
    .row {
      grid-template-columns: 40px minmax(0, 1fr) 20px;
      grid-template-areas:
        'no name go'
        'no tags go';
      gap: 4px 14px;
      padding: 18px 6px;
    }
    .row__no {
      grid-area: no;
      align-self: start;
      padding-top: 4px;
    }
    .row__name {
      grid-area: name;
    }
    .row__tags {
      grid-area: tags;
      font-size: 0.85rem;
    }
    .row__plat {
      display: none;
    }
    .row__go {
      grid-area: go;
    }
  }
</style>

<script>
  import { finePointer, prefersReduced } from '../scripts/core';
  import { tick } from '../scripts/sound';

  import { ScrollTrigger } from '../scripts/core';

  // "Show all" toggles for capped lists.
  document.querySelectorAll<HTMLButtonElement>('[data-rows-more]').forEach((btn) => {
    if (btn.dataset.bound) return;
    btn.dataset.bound = '1';
    const list = btn.previousElementSibling as HTMLElement;
    btn.addEventListener('click', () => {
      const open = btn.getAttribute('aria-expanded') !== 'true';
      btn.setAttribute('aria-expanded', String(open));
      list.classList.toggle('is-capped', !open);
      btn.querySelector<HTMLElement>('[data-label-more]')!.hidden = open;
      btn.querySelector<HTMLElement>('[data-label-less]')!.hidden = !open;
      if (!open) list.scrollIntoView({ block: 'nearest' });
      requestAnimationFrame(() => ScrollTrigger.refresh());
    });
  });

  // One shared floating preview for every row list on the page.
  let preview = document.querySelector<HTMLElement>('.row-preview');
  if (!preview) {
    preview = document.createElement('div');
    preview.className = 'row-preview';
    preview.setAttribute('aria-hidden', 'true');
    preview.innerHTML = '<div class="row-preview__card"><img alt="" decoding="async" /></div>';
    document.body.appendChild(preview);
  }
  const card = preview.querySelector<HTMLElement>('.row-preview__card')!;
  const img = preview.querySelector<HTMLImageElement>('img')!;

  const enabled = finePointer();
  let x = 0,
    y = 0,
    cx = 0,
    cy = 0,
    vx = 0,
    raf = 0,
    visible = false;

  function loop() {
    const k = prefersReduced() ? 1 : 0.14;
    const px = cx;
    cx += (x - cx) * k;
    cy += (y - cy) * k;
    vx = cx - px;
    const tilt = Math.max(-10, Math.min(10, vx * 0.6));
    preview!.style.transform = `translate3d(${cx}px, ${cy}px, 0)`;
    // Flip the card so it never leaves the viewport near the top or right edge.
    card.style.marginTop = cy < 290 ? '28px' : '';
    card.style.marginLeft = cx > window.innerWidth - 360 ? '-328px' : '';
    card.style.transformOrigin = `${cx > window.innerWidth - 360 ? '100%' : '0'} ${cy < 290 ? '0' : '100%'}`;
    card.style.rotate = `${tilt}deg`;
    if (visible || Math.abs(x - cx) > 0.5 || Math.abs(y - cy) > 0.5) raf = requestAnimationFrame(loop);
    else raf = 0;
  }

  function show(src: string) {
    if (!src) return hide();
    if (img.getAttribute('src') !== src) img.src = src;
    visible = true;
    preview!.classList.add('is-visible');
    if (!raf) raf = requestAnimationFrame(loop);
  }

  function hide() {
    visible = false;
    preview!.classList.remove('is-visible');
  }

  if (enabled) {
    document.querySelectorAll<HTMLElement>('[data-rows]').forEach((list) => {
      if (list.dataset.bound) return;
      list.dataset.bound = '1';
      list.addEventListener('pointermove', (e) => {
        x = e.clientX;
        y = e.clientY;
        if (!visible) {
          cx = x;
          cy = y;
        }
      });
      list.addEventListener('pointerover', (e) => {
        const row = (e.target as HTMLElement).closest<HTMLElement>('.row');
        if (!row || row.contains(e.relatedTarget as Node)) return;
        show(row.dataset.preview || '');
        tick();
      });
      list.addEventListener('pointerleave', hide);
    });
    window.addEventListener('scroll', hide, { passive: true });
  }
</script>

<style is:global>
  .row-preview {
    position: fixed;
    top: 0;
    left: 0;
    z-index: calc(var(--z-overlay) - 1);
    pointer-events: none;
    will-change: transform;
  }

  .row-preview__card {
    width: 300px;
    aspect-ratio: 4 / 3;
    margin: -250px 0 0 28px;
    padding: 8px;
    border-radius: var(--r-media);
    background: var(--paper);
    box-shadow:
      0 0 0 1px rgb(var(--text-rgb) / 0.1),
      0 30px 60px -20px rgb(var(--shadow-tint) / 0.45);
    opacity: 0;
    scale: 0.6;
    transform-origin: 0 100%;
    transition:
      opacity 0.3s var(--ease-out),
      scale 0.45s var(--ease-out);
  }

  .row-preview.is-visible .row-preview__card {
    opacity: 1;
    scale: 1;
  }

  .row-preview__card img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    border-radius: 6px;
  }
</style>
