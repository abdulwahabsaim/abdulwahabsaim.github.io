---
import { getCollection } from 'astro:content';
import { Icon } from 'astro-icon/components';
import { nav } from '../data/site';

const labs = (await getCollection('labs')).sort((a, b) =>
  a.data.categorySlug === b.data.categorySlug ? a.data.order - b.data.order : a.data.categorySlug.localeCompare(b.data.categorySlug),
);

const items = [
  ...nav.map((n) => ({ kind: 'Section', name: n.label, meta: '', href: `/${n.href}`, hay: n.label.toLowerCase() })),
  ...labs.map((l) => ({
    kind: 'Lab',
    name: l.data.name,
    meta: l.data.category,
    href: `/labs/${l.id}/`,
    hay: [l.data.name, l.data.title, l.data.category, ...l.data.tags].join(' ').toLowerCase(),
  })),
];
---

<dialog class="cmd" data-cmd aria-label="Search labs and sections">
  <div class="cmd__panel">
    <label class="cmd__field">
      <Icon name="ph:magnifying-glass" />
      <span class="sr-only">Search</span>
      <input
        type="text"
        placeholder="Search labs: OSPF, HSRP, DHCP, ACL..."
        autocomplete="off"
        spellcheck="false"
        data-cmd-input
        role="combobox"
        aria-expanded="true"
        aria-controls="cmd-list"
        aria-autocomplete="list"
      />
      <kbd class="cmd__kbd mono">Esc</kbd>
    </label>
    <ul class="cmd__list" id="cmd-list" role="listbox" data-cmd-list data-lenis-prevent>
      {
        items.map((it, i) => (
          <li role="option" id={`cmd-${i}`} data-hay={it.hay} data-name={it.name.toLowerCase()} data-i={i} data-kind={it.kind} aria-selected="false">
            <a href={it.href} tabindex="-1">
              <span class="cmd__kind mono">{it.kind}</span>
              <span class="cmd__name">{it.name}</span>
              {it.meta && <span class="cmd__meta">{it.meta}</span>}
              <Icon name="ph:arrow-right" class="cmd__go" />
            </a>
          </li>
        ))
      }
    </ul>
    <p class="cmd__empty" data-cmd-empty hidden>No lab matches that. Try a protocol name like OSPF or DAI.</p>
    <div class="cmd__foot mono">
      <span><kbd>↑</kbd><kbd>↓</kbd> move</span>
      <span><kbd>Enter</kbd> open</span>
      <span class="cmd__count" data-cmd-count></span>
    </div>
  </div>
</dialog>

<style>
  .cmd {
    width: min(640px, calc(100vw - 24px));
    max-width: none;
    max-height: none;
    margin: max(12px, 12vh) auto auto;
    padding: 0;
    border: 0;
    border-radius: var(--r-card);
    background: transparent;
    color: var(--text);
    overflow: visible;
  }

  .cmd::backdrop {
    background: rgb(var(--bg-rgb) / 0.55);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
  }

  .cmd[open] .cmd__panel {
    animation: cmd-in 0.35s var(--ease-out);
  }

  @keyframes cmd-in {
    from {
      opacity: 0;
      transform: translateY(-8px) scale(0.98);
    }
  }

  .cmd__panel {
    display: flex;
    flex-direction: column;
    max-height: min(560px, calc(100dvh - 24px - 12vh));
    border-radius: var(--r-card);
    background: var(--surface);
    box-shadow:
      inset 0 0 0 1px var(--line-2),
      0 40px 80px -30px rgb(var(--shadow-tint) / 0.45);
    overflow: hidden;
  }

  .cmd__field {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 0 16px;
    height: 60px;
    border-bottom: 1px solid var(--line);
    flex: none;
  }

  .cmd__field svg {
    width: 20px;
    height: 20px;
    color: var(--text-3);
    flex: none;
  }

  .cmd__field input {
    flex: 1;
    min-width: 0;
    height: 100%;
    border: 0;
    outline: 0;
    background: transparent;
    font-size: 1rem;
  }

  .cmd__field input::placeholder {
    color: var(--text-3);
  }

  kbd {
    display: inline-grid;
    place-items: center;
    min-width: 22px;
    height: 22px;
    padding-inline: 6px;
    border-radius: 6px;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--text-2);
    box-shadow: inset 0 0 0 1px var(--line-2);
  }

  .cmd__list {
    list-style: none;
    padding: 8px;
    margin: 0;
    overflow-y: auto;
    overscroll-behavior: contain;
  }

  .cmd__list li[hidden] {
    display: none;
  }

  .cmd__list a {
    display: grid;
    grid-template-columns: 64px 1fr auto 18px;
    align-items: center;
    gap: 12px;
    padding: 11px 12px;
    border-radius: 12px;
    color: var(--text-2);
  }

  .cmd__list [aria-selected='true'] a {
    background: rgb(var(--text-rgb) / 0.07);
    color: var(--text);
  }

  .cmd__kind {
    font-size: 0.7rem;
    color: var(--text-3);
  }

  .cmd__name {
    color: var(--text);
    font-weight: 500;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .cmd__meta {
    font-size: 0.8rem;
    color: var(--text-3);
    white-space: nowrap;
  }

  .cmd__go {
    width: 16px;
    height: 16px;
    opacity: 0;
    transition:
      opacity 0.2s ease,
      transform 0.3s var(--ease-out);
  }

  .cmd__list [aria-selected='true'] .cmd__go {
    opacity: 1;
    color: var(--accent-text);
  }

  .cmd__empty {
    padding: 28px 20px;
    color: var(--text-2);
    text-align: center;
  }

  .cmd__foot {
    display: flex;
    gap: 16px;
    align-items: center;
    padding: 10px 16px;
    border-top: 1px solid var(--line);
    font-size: 0.72rem;
    color: var(--text-3);
    flex: none;
  }

  .cmd__foot span {
    display: inline-flex;
    gap: 4px;
    align-items: center;
  }

  .cmd__count {
    margin-left: auto;
  }

  @media (max-width: 560px) {
    .cmd {
      margin-top: max(10px, env(safe-area-inset-top));
    }
    .cmd__list a {
      grid-template-columns: 1fr 16px;
      gap: 4px 10px;
    }
    .cmd__kind {
      display: none;
    }
    .cmd__meta {
      grid-column: 1;
      grid-row: 2;
    }
    .cmd__go {
      grid-row: 1 / span 2;
      grid-column: 2;
    }
    .cmd__foot span:not(.cmd__count) {
      display: none;
    }
    .cmd__kbd {
      display: none;
    }
  }
</style>

<script>
  import { lockScroll } from '../scripts/core';
  import { whoosh, tick } from '../scripts/sound';

  const dlg = document.querySelector<HTMLDialogElement>('[data-cmd]')!;
  const input = dlg.querySelector<HTMLInputElement>('[data-cmd-input]')!;
  const list = dlg.querySelector<HTMLUListElement>('[data-cmd-list]')!;
  const empty = dlg.querySelector<HTMLElement>('[data-cmd-empty]')!;
  const count = dlg.querySelector<HTMLElement>('[data-cmd-count]')!;
  const options = [...list.querySelectorAll<HTMLLIElement>('li')];
  let active = -1;

  const visible = () => options.filter((o) => !o.hidden);

  function setActive(i: number, scroll = true) {
    const vis = visible();
    options.forEach((o) => o.setAttribute('aria-selected', 'false'));
    if (!vis.length) {
      active = -1;
      input.removeAttribute('aria-activedescendant');
      return;
    }
    active = (i + vis.length) % vis.length;
    const el = vis[active];
    el.setAttribute('aria-selected', 'true');
    input.setAttribute('aria-activedescendant', el.id);
    if (scroll) el.scrollIntoView({ block: 'nearest' });
  }

  function filter() {
    const q = input.value.trim().toLowerCase();
    const terms = q.split(/\s+/).filter(Boolean);
    let n = 0;
    const score = (o: HTMLLIElement) => {
      if (!q) return 0;
      const name = o.dataset.name || '';
      if (name.startsWith(q)) return 3;
      if (terms.every((t) => name.includes(t))) return 2;
      return 1;
    };
    options.forEach((o) => {
      const hay = o.dataset.hay || '';
      const show = terms.every((t) => hay.includes(t));
      o.hidden = !show;
      if (show && o.dataset.kind === 'Lab') n++;
    });
    // Best matches first: names before tags, then original order.
    [...options]
      .sort((a, b) => score(b) - score(a) || Number(a.dataset.i) - Number(b.dataset.i))
      .forEach((o) => list.appendChild(o));
    empty.hidden = visible().length > 0;
    count.textContent = `${n} lab${n === 1 ? '' : 's'}`;
    setActive(0, false);
    list.scrollTop = 0;
  }

  function open() {
    if (dlg.open) return;
    input.value = '';
    filter();
    dlg.showModal();
    lockScroll(true);
    whoosh();
    requestAnimationFrame(() => input.focus());
  }

  dlg.addEventListener('close', () => lockScroll(false));
  dlg.addEventListener('click', (e) => {
    if (e.target === dlg) dlg.close();
  });

  input.addEventListener('input', filter);
  input.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowDown') {
      e.preventDefault();
      setActive(active + 1);
      tick();
    } else if (e.key === 'ArrowUp') {
      e.preventDefault();
      setActive(active - 1);
      tick();
    } else if (e.key === 'Enter') {
      const el = visible()[active];
      const a = el?.querySelector('a');
      if (a) {
        e.preventDefault();
        dlg.close();
        a.click();
      }
    }
  });

  list.addEventListener('pointermove', (e) => {
    const li = (e.target as HTMLElement).closest('li');
    if (!li) return;
    const i = visible().indexOf(li as HTMLLIElement);
    if (i !== active) {
      setActive(i, false);
      tick();
    }
  });
  list.addEventListener('click', (e) => {
    if ((e.target as HTMLElement).closest('a')) dlg.close();
  });

  document.addEventListener('click', (e) => {
    if ((e.target as HTMLElement).closest('[data-cmd-open]')) {
      e.preventDefault();
      setTimeout(open, 10);
    }
  });

  document.addEventListener('keydown', (e) => {
    const typing = (e.target as HTMLElement).closest('input, textarea, [contenteditable]');
    if ((e.key === 'k' || e.key === 'K') && (e.metaKey || e.ctrlKey)) {
      e.preventDefault();
      dlg.open ? dlg.close() : open();
    } else if (e.key === '/' && !typing && !dlg.open) {
      e.preventDefault();
      open();
    }
  });
</script>
