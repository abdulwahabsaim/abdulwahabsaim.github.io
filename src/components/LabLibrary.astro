---
/*
 * Lab library: codesval-style glass folders. Hover leans the folder open, click files out the
 * labs below as hover-preview rows. Routing is open by default so the pattern is obvious.
 */
import { getCollection } from 'astro:content';
import { getImage } from 'astro:assets';
import { categories } from '../data/site';
import LabRows from './LabRows.astro';
import { topologies } from '../data/topologies';

const all = await getCollection('labs');
const folders = await Promise.all(
  categories.map(async (c) => {
    const labs = all.filter((l) => l.data.categorySlug === c.slug).sort((a, b) => a.data.order - b.data.order);
    const papers = await Promise.all(
      labs
        .filter((l) => topologies[l.id] || l.data.image)
        .slice(0, 3)
        .map(async (l) =>
          topologies[l.id] ? `/topology/${l.id}.svg` : (await getImage({ src: l.data.image!, width: 320, format: 'webp', quality: 70 })).src,
        ),
    );
    return { ...c, labs, papers, inProgress: labs.some((l) => l.data.status === 'in-progress') };
  }),
);
const total = all.length;
const DEFAULT = 'routing';
---

<section class="section library" id="labs" aria-labelledby="labs-title">
  <div class="container">
    <header class="section-head">
      <h2 class="h2" id="labs-title" data-reveal>The lab library</h2>
      <p class="lead" data-reveal style="--d:80">
        {total} labs, filed the way I study them. Open a folder to see what's inside.
      </p>
    </header>

    <div class="folders" role="tablist" aria-label="Lab categories" data-folders data-rail data-reveal>
      {
        folders.map((f, i) => (
          <button
            class="folder"
            type="button"
            role="tab"
            id={`tab-${f.slug}`}
            aria-selected={f.slug === DEFAULT ? 'true' : 'false'}
            aria-controls={`panel-${f.slug}`}
            tabindex={f.slug === DEFAULT ? 0 : -1}
            data-folder={f.slug}
          >
            <span class="folder__body" aria-hidden="true">
              <span class="folder__back" />
              <span class="folder__papers">
                {f.papers.map((src) => (
                  <span class="folder__paper">
                    <img src={src} alt="" loading="lazy" decoding="async" />
                  </span>
                ))}
              </span>
              <span class="folder__front" />
            </span>
            <span class="folder__label">
              <span class="folder__name">{f.label}</span>
              <span class="folder__count mono">
                {f.labs.length} labs{f.inProgress ? ', in progress' : ''}
              </span>
            </span>
          </button>
        ))
      }
    </div>

    <div class="panels">
      {
        folders.map((f) => (
          <div
            class="panel"
            id={`panel-${f.slug}`}
            role="tabpanel"
            aria-labelledby={`tab-${f.slug}`}
            data-panel={f.slug}
            hidden={f.slug !== DEFAULT}
          >
            <p class="panel__blurb">{f.blurb}</p>
            <LabRows labs={f.labs} limit={6} />
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .folders {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: clamp(16px, 2.6vw, 36px);
    margin-bottom: clamp(40px, 6vw, 72px);
  }

  .folder {
    --lean: 0deg;
    --rise: 0%;
    position: relative;
    display: grid;
    gap: 14px;
    text-align: left;
    perspective: 900px;
  }

  .folder__body {
    position: relative;
    display: block;
    aspect-ratio: 1.28;
    transform-style: preserve-3d;
    transition: transform 0.6s var(--ease-out);
  }

  /* Back plate with a tab, like a real file folder. */
  .folder__back {
    position: absolute;
    inset: 9% 0 0;
    border-radius: 6px 18px 18px 18px;
    background: linear-gradient(165deg, #ff8a4c, var(--accent) 45%, #e8520f);
    box-shadow: 0 24px 40px -24px rgb(var(--accent-rgb) / 0.55);
  }

  .folder__back::before {
    content: '';
    position: absolute;
    left: 0;
    bottom: 100%;
    width: 40%;
    height: 13%;
    min-height: 14px;
    border-radius: 12px 14px 0 0;
    background: #ff8a4c;
  }

  .folder__back::after {
    content: '';
    position: absolute;
    left: calc(40% - 10px);
    bottom: calc(100% - 1px);
    width: 22px;
    height: 13%;
    min-height: 14px;
    background: #ff8a4c;
    transform: skewX(38deg);
    transform-origin: 0 100%;
    border-top-right-radius: 8px;
  }

  .folder__papers {
    position: absolute;
    inset: 15% 8% 16%;
    transform: translateY(var(--rise));
    transition: transform 0.6s var(--ease-out);
  }

  .folder__paper {
    position: absolute;
    inset: 0;
    padding: 5px;
    border-radius: 8px;
    background: var(--paper);
    box-shadow: 0 6px 16px -8px rgb(0 0 0 / 0.35);
    transition: transform 0.6s var(--ease-out);
  }

  .folder__paper img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    background: #fff;
    border-radius: 4px;
  }

  .folder__paper:nth-child(1) {
    transform: rotate(-5deg) translateX(-4%);
  }

  .folder__paper:nth-child(2) {
    transform: rotate(3deg) translateX(3%);
  }

  .folder__paper:nth-child(3) {
    transform: rotate(-1deg);
  }

  /* Frosted glass front, hinged at the bottom. */
  .folder__front {
    position: absolute;
    inset: 30% 0 0;
    border-radius: 16px;
    /* Tinted glass: clear at the top where the papers show through, warmer towards the hinge. */
    background: linear-gradient(
      180deg,
      rgb(255 255 255 / 0.5) 0%,
      rgb(255 214 190 / 0.62) 55%,
      rgb(255 160 110 / 0.86) 100%
    );
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.85),
      inset 0 0 0 1px rgb(255 255 255 / 0.45),
      0 -10px 30px -16px rgb(120 40 0 / 0.35);
    backdrop-filter: blur(10px) saturate(140%);
    -webkit-backdrop-filter: blur(10px) saturate(140%);
    transform-origin: 50% 100%;
    transform: rotateX(var(--lean));
    transition: transform 0.6s var(--ease-out);
  }

  :global([data-theme='dark']) .folder__front {
    background: linear-gradient(
      180deg,
      rgb(255 255 255 / 0.22) 0%,
      rgb(255 190 150 / 0.34) 55%,
      rgb(255 130 70 / 0.62) 100%
    );
  }

  .folder__label {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 4px 12px;
    padding-inline: 4px;
  }

  .folder__name {
    font-weight: 600;
    font-size: 1.05rem;
    letter-spacing: -0.02em;
  }

  .folder__count {
    font-size: 0.75rem;
    color: var(--text-3);
  }

  .folder[aria-selected='true'] {
    --lean: -20deg;
    --rise: -16%;
  }

  .folder[aria-selected='true'] .folder__paper:nth-child(1) {
    transform: rotate(-9deg) translate(-10%, -4%);
  }

  .folder[aria-selected='true'] .folder__paper:nth-child(2) {
    transform: rotate(7deg) translate(9%, -2%);
  }

  .folder[aria-selected='true'] .folder__name {
    color: var(--accent-text);
  }

  .folders.has-open .folder[aria-selected='false'] .folder__body {
    opacity: 0.72;
  }

  .folder__body {
    transition:
      transform 0.6s var(--ease-out),
      opacity 0.4s ease;
  }

  @media (hover: hover) {
    .folder:hover {
      --lean: -12deg;
      --rise: -9%;
    }
    .folder[aria-selected='true']:hover {
      --lean: -22deg;
      --rise: -18%;
    }
    .folder:hover .folder__body {
      transform: translateY(-6px);
      opacity: 1;
    }
  }

  .panel__blurb {
    color: var(--text-2);
    margin-bottom: 20px;
    max-width: 60ch;
  }

  .panel:not([hidden]) {
    animation: panel-in 0.6s var(--ease-out);
  }

  .panel:not([hidden]) :global(.rows li) {
    animation: row-in 0.7s var(--ease-out) both;
    animation-delay: calc(var(--r) * 35ms + 80ms);
  }

  @keyframes panel-in {
    from {
      opacity: 0;
    }
  }

  @keyframes row-in {
    from {
      opacity: 0;
      transform: translateY(14px);
    }
  }

  @media (min-width: 701px) and (max-width: 900px) {
    .folders {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      row-gap: 32px;
    }
  }

  @media (max-width: 700px) {
    /* Folders become a swipeable row; room on top for the papers that rise out of the open one. */
    .folders {
      --rail-w: 46%;
      padding-top: 28px;
      margin-top: -28px;
      margin-bottom: 28px;
      gap: 14px;
    }
    .folder__label {
      flex-direction: column;
      align-items: flex-start;
    }
    .folder__name {
      font-size: 0.98rem;
    }
  }

  @media (max-width: 380px) {
    .folders {
      gap: 14px;
      row-gap: 24px;
    }
    .folder__name {
      font-size: 0.95rem;
    }
  }
</style>

<script>
  import { whoosh } from '../scripts/sound';
  import { ScrollTrigger } from '../scripts/core';

  const wrap = document.querySelector<HTMLElement>('[data-folders]')!;
  const tabs = [...wrap.querySelectorAll<HTMLButtonElement>('[data-folder]')];
  const panels = [...document.querySelectorAll<HTMLElement>('[data-panel]')];
  wrap.classList.add('has-open');

  function select(tab: HTMLButtonElement, focus = false) {
    const slug = tab.dataset.folder!;
    if (tab.getAttribute('aria-selected') === 'true') return;
    tabs.forEach((t) => {
      const on = t === tab;
      t.setAttribute('aria-selected', String(on));
      t.tabIndex = on ? 0 : -1;
    });
    panels.forEach((p) => (p.hidden = p.dataset.panel !== slug));
    if (focus) tab.focus();
    whoosh();
    // Panel height changed: later ScrollTriggers (process, timeline) must re-measure.
    requestAnimationFrame(() => ScrollTrigger.refresh());
  }

  tabs.forEach((t) => t.addEventListener('click', () => select(t)));
  wrap.addEventListener('keydown', (e) => {
    const i = tabs.indexOf(document.activeElement as HTMLButtonElement);
    if (i < 0) return;
    let n = -1;
    if (e.key === 'ArrowRight') n = (i + 1) % tabs.length;
    if (e.key === 'ArrowLeft') n = (i - 1 + tabs.length) % tabs.length;
    if (e.key === 'Home') n = 0;
    if (e.key === 'End') n = tabs.length - 1;
    if (n >= 0) {
      e.preventDefault();
      select(tabs[n], true);
    }
  });
</script>
