---
/*
 * GitHub activity (shafisma idea): contribution heatmap from a build-time snapshot
 * (scripts/sync-github.mjs, refreshed by the daily deploy) plus the lab repositories.
 */
import { Icon } from 'astro-icon/components';
import gh from '../data/github.json';
import { profile, repoBlurbs } from '../data/site';

type Day = [string, number, number];
type Year = { year: number; total: number; days: Day[] };
const fmt = new Intl.DateTimeFormat('en-GB', { day: 'numeric', month: 'short', year: 'numeric', timeZone: 'UTC' });
const monthFmt = new Intl.DateTimeFormat('en-US', { month: 'short', timeZone: 'UTC' });
const today = new Date().toISOString().slice(0, 10);

/** Lay one calendar out like GitHub: columns are weeks starting on Sunday. */
function grid(days: Day[]) {
  const firstDow = new Date(`${days[0][0]}T00:00:00Z`).getUTCDay();
  const cells = days.map(([date, count, level], i) => {
    const idx = i + firstDow;
    return { date, count, level, future: date > today, col: Math.floor(idx / 7), row: idx % 7 };
  });
  const cols = cells[cells.length - 1].col + 1;
  const months: { col: number; label: string }[] = [];
  cells.forEach((c) => {
    if (c.date.endsWith('-01') || (c.col === 0 && c.row === firstDow)) {
      const col = c.row === 0 ? c.col : c.col + 1;
      if (!months.some((m) => Math.abs(m.col - col) < 3)) months.push({ col, label: monthFmt.format(new Date(`${c.date}T00:00:00Z`)) });
    }
  });
  return { cells, cols, months };
}

// Year tabs like the GitHub profile; older snapshots without per-year data fall back to the last 12 months.
const years: Year[] = (gh as { years?: Year[] }).years?.length
  ? (gh as { years: Year[] }).years
  : [{ year: new Date().getUTCFullYear(), total: gh.lastYearTotal, days: gh.days as Day[] }];
const panels = years.map((y) => ({ ...y, ...grid(y.days) }));
const allTime = years.reduce((a, y) => a + y.total, 0);
const since = years[years.length - 1].year;

const totalCommits = gh.repos.reduce((a, r) => a + (r.commits ?? 0), 0);
const updated = (iso: string) => new Intl.DateTimeFormat('en-US', { month: 'short', year: 'numeric' }).format(new Date(iso));
const stats = [
  { value: allTime, label: `contributions on GitHub since ${since}` },
  { value: totalCommits, label: 'commits across the lab repositories' },
  { value: gh.publicRepos ?? gh.repos.length, label: 'public repositories on GitHub' },
];
---

<section class="section gh" id="github" aria-labelledby="gh-title">
  <div class="container">
    <header class="section-head">
      <h2 class="h2" id="gh-title" data-reveal>Everything lives in Git</h2>
      <p class="lead" data-reveal style="--d:80">
        Configs, topologies and runbooks for every lab, pushed one file per commit.
      </p>
    </header>

    <div class="gh__card" data-reveal>
      <dl class="gh__stats">
        {
          stats.map((s) => (
            <div>
              <dt class="sr-only">{s.label}</dt>
              <dd class="gh__num" data-count={s.value}>
                {s.value}
              </dd>
              <dd class="gh__label">{s.label}</dd>
            </div>
          ))
        }
      </dl>

      <div class="gh__bar">
        <p class="gh__year-total" data-gh-total aria-live="polite">
          {panels[0].total} contributions in {panels[0].year}
        </p>
        <div class="gh__tabs mono" role="tablist" aria-label="Contribution year">
          {
            panels.map((p, i) => (
              <button
                type="button"
                role="tab"
                class="gh__tab"
                id={`gh-tab-${p.year}`}
                aria-controls={`gh-year-${p.year}`}
                aria-selected={i === 0 ? 'true' : 'false'}
                tabindex={i === 0 ? 0 : -1}
                data-gh-tab={p.year}
                data-total={p.total}
              >
                {p.year}
              </button>
            ))
          }
        </div>
      </div>

      {
        panels.map((p, i) => (
          <div class="gh__scroll" data-gh-scroll data-hscroll data-current={i === 0 ? '' : undefined} id={`gh-year-${p.year}`} role="tabpanel" aria-labelledby={`gh-tab-${p.year}`} hidden={i !== 0}>
            <div class="gh__graph" style={`--cols:${p.cols}`}>
              <div class="gh__months" aria-hidden="true">
                {p.months.map((m) => <span style={`grid-column:${m.col + 1}`}>{m.label}</span>)}
              </div>
              <div class="gh__cells" role="img" aria-label={`${p.total} contributions in ${p.year}`}>
                {p.cells.map((c) => (
                  <span
                    class="gh__cell"
                    data-l={c.level}
                    data-future={c.future ? '' : undefined}
                    style={`grid-column:${c.col + 1};grid-row:${c.row + 1};--c:${c.col}`}
                    data-tip={c.future ? undefined : `${c.count === 0 ? 'No' : c.count} contribution${c.count === 1 ? '' : 's'} on ${fmt.format(new Date(`${c.date}T00:00:00Z`))}`}
                  />
                ))}
              </div>
            </div>
          </div>
        ))
      }
      <div class="gh__legend mono" aria-hidden="true">
        <span>Less</span>
        {[0, 1, 2, 3, 4].map((l) => <span class="gh__cell" data-l={l} />)}
        <span>More</span>
      </div>
      <div class="gh__tip mono" data-gh-tip hidden></div>
    </div>

    <ul class="repos" data-rail data-reveal>
      {
        gh.repos.map((r, i) => (
          <li>
            <a class="repo" href={r.url} target="_blank" rel="noopener">
              <span class="repo__top">
                <Icon name="ph:git-commit" />
                <span class="repo__commits mono">{r.commits ?? '-'} commits</span>
                <Icon name="ph:arrow-up-right" class="repo__go" />
              </span>
              <span class="repo__name mono">{r.name}</span>
              <span class="repo__blurb">{repoBlurbs[r.name] ?? r.description}</span>
              <span class="repo__date">Updated {updated(r.pushedAt)}</span>
            </a>
          </li>
        ))
      }
    </ul>

    <a class="gh__profile" href={profile.github} target="_blank" rel="noopener" data-reveal>
      <Icon name="simple-icons:github" />
      <span class="link">github.com/abdulwahabsaim</span>
    </a>
  </div>
</section>

<style>
  .gh__card {
    position: relative;
    padding: clamp(20px, 3vw, 36px);
    border-radius: var(--r-panel);
    background: var(--surface);
    box-shadow: 0 0 0 1px var(--line-2);
  }

  .gh__stats {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
    margin-bottom: clamp(24px, 3vw, 36px);
  }

  .gh__num {
    font-size: clamp(2rem, 4vw, 3.2rem);
    font-weight: 600;
    letter-spacing: -0.04em;
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }

  .gh__label {
    margin-top: 8px;
    font-size: 0.9rem;
    color: var(--text-2);
  }

  .gh__bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px 20px;
    margin-bottom: 18px;
  }

  .gh__year-total {
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }

  .gh__tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .gh__tab {
    padding: 6px 12px;
    border-radius: 999px;
    font-size: 0.78rem;
    color: var(--text-2);
    box-shadow: 0 0 0 1px var(--line-2);
    transition:
      background-color 0.2s,
      color 0.2s,
      box-shadow 0.2s;
  }

  .gh__tab:hover {
    color: var(--text);
  }

  .gh__tab[aria-selected='true'] {
    background: var(--accent);
    color: #fff;
    box-shadow: none;
  }

  .gh__tab:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .gh__scroll[hidden] {
    display: none;
  }

  .gh__scroll {
    overflow-x: auto;
    padding-bottom: 6px;
    scrollbar-width: thin;
  }

  .gh__graph {
    --cell: 13px;
    --gap: 4px;
    width: max-content;
    margin-inline: auto;
  }

  .gh__months,
  .gh__cells {
    display: grid;
    grid-template-columns: repeat(var(--cols), var(--cell));
    gap: var(--gap);
  }

  .gh__months {
    margin-bottom: 8px;
    font-size: 0.72rem;
    color: var(--text-3);
    height: 14px;
  }

  .gh__months span {
    white-space: nowrap;
  }

  .gh__cells {
    grid-template-rows: repeat(7, var(--cell));
  }

  .gh__cell {
    display: block;
    width: var(--cell, 12px);
    height: var(--cell, 12px);
    border-radius: 3px;
    background: rgb(var(--text-rgb) / 0.07);
  }

  .gh__cell[data-l='1'] {
    background: rgb(var(--accent-rgb) / 0.32);
  }
  .gh__cell[data-l='2'] {
    background: rgb(var(--accent-rgb) / 0.55);
  }
  .gh__cell[data-l='3'] {
    background: rgb(var(--accent-rgb) / 0.8);
  }
  .gh__cell[data-l='4'] {
    background: var(--accent);
  }

  .gh__cell[data-future] {
    background: rgb(var(--text-rgb) / 0.03);
  }

  :global(.js) .gh__cells .gh__cell {
    opacity: 0;
    transform: scale(0.4);
  }

  :global(.js) .gh__card.is-in .gh__cells .gh__cell {
    animation: cell-in 0.5s var(--ease-out) forwards;
    animation-delay: calc(var(--c) * 14ms + 150ms);
  }

  /* Switching years: a quicker sweep than the first reveal. */
  :global(.js) .gh__card.is-switched .gh__cells .gh__cell {
    animation-duration: 0.3s;
    animation-delay: calc(var(--c) * 4ms);
  }

  @keyframes cell-in {
    to {
      opacity: 1;
      transform: none;
    }
  }

  .gh__legend {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 5px;
    margin-top: 16px;
    font-size: 0.72rem;
    color: var(--text-3);
  }

  .gh__legend .gh__cell {
    --cell: 11px;
  }

  .gh__tip {
    position: absolute;
    left: 0;
    top: 0;
    z-index: 3;
    padding: 7px 10px;
    border-radius: 8px;
    background: var(--text);
    color: var(--bg);
    font-size: 0.75rem;
    white-space: nowrap;
    pointer-events: none;
    transform: translate(-50%, calc(-100% - 10px));
  }

  .repos {
    list-style: none;
    padding: 0;
    margin-top: clamp(14px, 1.6vw, 20px);
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 210px), 1fr));
    gap: clamp(14px, 1.6vw, 20px);
  }

  .repo {
    display: grid;
    gap: 10px;
    height: 100%;
    padding: 20px;
    border-radius: var(--r-card);
    box-shadow: inset 0 0 0 1px var(--line-2);
    transition:
      background-color 0.3s ease,
      box-shadow 0.3s ease,
      transform 0.4s var(--ease-out);
  }

  .repo__top {
    display: flex;
    align-items: center;
    gap: 8px;
    color: var(--text-3);
  }

  .repo__top svg {
    width: 18px;
    height: 18px;
  }

  .repo__commits {
    font-size: 0.75rem;
  }

  .repo__go {
    margin-left: auto;
    transition: transform 0.4s var(--ease-out);
  }

  .repo__name {
    font-size: 0.88rem;
    font-weight: 500;
    color: var(--text);
    overflow-wrap: anywhere;
  }

  .repo__blurb {
    font-size: 0.9rem;
    color: var(--text-2);
    line-height: 1.5;
  }

  .repo__date {
    font-size: 0.8rem;
    color: var(--text-3);
    margin-top: auto;
  }

  @media (hover: hover) {
    .repo:hover {
      background: var(--surface);
      box-shadow: inset 0 0 0 1px rgb(var(--accent-rgb) / 0.6);
      transform: translateY(-3px);
    }
    .repo:hover .repo__go {
      color: var(--accent-text);
      transform: translate(2px, -2px);
    }
  }

  .gh__profile {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin-top: 28px;
    font-weight: 500;
  }

  .gh__profile svg {
    width: 20px;
    height: 20px;
  }

  @media (max-width: 700px) {
    .gh__stats {
      gap: 12px;
    }
    .gh__num {
      font-size: 1.9rem;
    }
    .gh__label {
      font-size: 0.75rem;
      line-height: 1.35;
    }
    .repos {
      --rail-w: 74%;
    }
    .gh__graph {
      --cell: 11px;
      --gap: 3px;
    }
  }
</style>

<script>
  const card = document.querySelector<HTMLElement>('.gh__card')!;
  const tip = document.querySelector<HTMLElement>('[data-gh-tip]')!;
  const total = card.querySelector<HTMLElement>('[data-gh-total]')!;
  const tabs = [...card.querySelectorAll<HTMLButtonElement>('[data-gh-tab]')];

  // Phones: the current year opens on its latest weeks, older years on January.
  const align = () => {
    const open = card.querySelector<HTMLElement>('[data-gh-scroll]:not([hidden])');
    if (open) open.scrollLeft = open.hasAttribute('data-current') ? open.scrollWidth : 0;
  };
  align();
  window.addEventListener('resize', align);

  // Year tabs.
  const select = (tab: HTMLButtonElement, focus = false) => {
    tabs.forEach((t) => {
      const on = t === tab;
      t.setAttribute('aria-selected', String(on));
      t.tabIndex = on ? 0 : -1;
      document.getElementById(t.getAttribute('aria-controls')!)!.hidden = !on;
    });
    total.textContent = `${tab.dataset.total} contributions in ${tab.dataset.ghTab}`;
    card.classList.add('is-switched');
    tip.hidden = true;
    align();
    if (focus) tab.focus();
  };
  tabs.forEach((t, i) => {
    t.addEventListener('click', () => select(t));
    t.addEventListener('keydown', (e) => {
      const step = e.key === 'ArrowRight' ? 1 : e.key === 'ArrowLeft' ? -1 : 0;
      if (step) select(tabs[(i + step + tabs.length) % tabs.length], true);
    });
  });

  // Count the numbers up when the card comes into view.
  const io = new IntersectionObserver(
    (entries) => {
      if (!entries[0].isIntersecting) return;
      io.disconnect();
      card.classList.add('is-in');
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      card.querySelectorAll<HTMLElement>('[data-count]').forEach((el) => {
        const target = Number(el.dataset.count);
        const t0 = performance.now();
        const run = (t: number) => {
          const k = Math.min(1, (t - t0) / 1400);
          el.textContent = String(Math.round(target * (1 - Math.pow(1 - k, 4))));
          if (k < 1) requestAnimationFrame(run);
        };
        requestAnimationFrame(run);
      });
    },
    { threshold: 0.3 },
  );
  io.observe(card);

  card.addEventListener('pointerover', (e) => {
    const cell = (e.target as HTMLElement).closest<HTMLElement>('.gh__cells .gh__cell');
    if (!cell || !cell.dataset.tip) {
      tip.hidden = true;
      return;
    }
    const r = cell.getBoundingClientRect();
    const c = card.getBoundingClientRect();
    tip.textContent = cell.dataset.tip || '';
    tip.hidden = false;
    tip.style.left = `${r.left - c.left + r.width / 2}px`;
    tip.style.top = `${r.top - c.top}px`;
  });
  card.addEventListener('pointerleave', () => (tip.hidden = true));
</script>
